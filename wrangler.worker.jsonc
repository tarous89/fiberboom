{
  "name": "fiberboom",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "main": "worker/index.mjs",
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiberboom-analytics",
      "database_id": "18d7c7dd-a2ff-4ba2-b7f1-e58af138194c"
    }
  ]
}
